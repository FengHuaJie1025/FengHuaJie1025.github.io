# 以下变量在【构建时】注入前端（仅 PUBLIC_ 前缀会被打包进浏览器）

# 1) SCF 云函数地址（腾讯云 API 网关，部署后在「函数管理 → 触发器」获取）
#    形如：https://service-xxxx.ap-guangzhou.apigw.tencentcs.com/release/api/ask
#    注意：该值构建时内联进前端，改完地址需重新 `astro build` + 部署。
PUBLIC_ASK_API=https://service-xxxx.ap-guangzhou.apigw.tencentcs.com/release/api/ask

# 2) AGNES_API_KEY 是【服务端密钥】，NOT 放这里（会进浏览器，泄露风险）。
#    它要在腾讯云 SCF 控制台的「函数配置 → 环境变量」里设置：
#    AGNES_API_KEY = sk-xxxx
#    AGNES_MODEL   = agnes-2.0-flash   （可省略，代码已默认）
#    AGNES_BASE_URL = https://apihub.agnes-ai.com/v1   （可省略，代码已默认）
